# ==================== REQUIRED ====================
API_ID=12345678
API_HASH=your_api_hash_here
STRING_SESSION=your_telethon_string_session_here

# ==================== OPTIONAL ====================
# Bot owner Telegram user ID (for owner-only commands)
OWNER_ID=123456789

# Command prefix (default: .)
CMD_PREFIX=.

# Keep-alive / Render
PORT=10000

# AI Features (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Extra
LOG_CHAT=          # Optional: chat ID where logs will be sent
PM_PERMIT=True     # Enable PM Permit
MAX_PM_FLOOD=5     # Max messages before blocking in PM
